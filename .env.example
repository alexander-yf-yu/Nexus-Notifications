# NEXUS enrollment center to watch. Blaine, WA is typically 5020 — confirm with `python main.py list-locations`.
LOCATION_ID=5020

# Your current booked appointment in ISO 8601. Any slot earlier than this triggers a notification.
CURRENT_APPOINTMENT=2026-06-08T09:00

# Twilio credentials — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio-provided phone number (E.164 format, e.g. +15551234567). Trial accounts get one free.
TWILIO_FROM=
# Your phone number in E.164 (e.g. +15559876543). On a trial account this must be a verified number.
TWILIO_TO=

# How often to poll the TTP API, in seconds. 120 = 2 min. Don't go below 60.
POLL_INTERVAL_S=120

# Where to persist known-slot state (container path; host path is ./data via compose).
STATE_PATH=/data/state.json

LOG_LEVEL=INFO

# Filter by day of week. Comma-separated weekday numbers: 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun
# Default (below) is Fri, Sat, Sun, Mon. Change to "1,2,3,4,5,6,7" for all days.
ALLOWED_WEEKDAYS=5,6,7,1

# Earliest date to consider slots. Any slot before this date is ignored.
# Format: ISO 8601 (e.g. 2026-05-01T00:00). Default is 2026-01-01.
MIN_DATE=2026-05-01T00:00
